# 結束封鎖全世界惡劣搜尋引擎

<RequireAny>
	Require env good_bot
	Require env bad_bot
</RequireAny>

<FilesMatch "(composer.json|package.json|package-lock.json|yarn.json)$">
    Require all denied
</FilesMatch>

<Files ~ "\.(env|htaccess|htpasswd|ini|bak|old|log|sh|sql|md|test)$">
  Require all denied
</Files>

#Enable Keep-Alive Headers
<IfModule mod_headers.c>
    Header unset Server
    Header unset X-Powered-By
    Header unset X-AspNet-Version
	Header unset ETag
	Header unset Date
	Header always unset X-Powered-By
	Header unset Content-Length
	Header unset X-Pad
   	Header set Connection Keep-Alive
</IfModule>

#Gzip compression
<IfModule mod_gzip.c>
   mod_gzip_on       Yes
   mod_gzip_dechunk  Yes
   mod_gzip_item_include file      .(html?|txt|css|js|php|pl|jpg|jpeg|png|gif|bmp)$
   mod_gzip_item_include handler   ^cgi-script$
   mod_gzip_item_include mime      ^text/.*
   mod_gzip_item_include mime      ^application/x-javascript.*
   mod_gzip_item_exclude mime      ^image/.*
   mod_gzip_item_exclude rspheader ^Content-Encoding:.*gzip.*
</IfModule>

#限制後臺路徑只允許給某固定 ip 訪問
<If "%{REQUEST_URI} =~ m#^/dashboards#">
    <RequireAll>
        Require all granted
        #Require ip 127.0.0.1
    </RequireAll>
</If>

<RequireAny>
 	<RequireAll>
	Require all granted
	#不允許 ip
	#Require not ip 192.168.1.0/24

    #允許 ip
	#Require ip 192.168.1.0/24
 	</RequireAll>
</RequireAny>

